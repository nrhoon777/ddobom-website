rules_version = '2';
// =============================================================
// 또봄 Firestore 보안 규칙
//  Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 붙여넣고 게시(Publish)하세요.
//
//  제휴 정산의 핵심 원칙 (서버에서 강제):
//   · 또봄은 '병원 확인란'을 쓸 수 없고, 병원은 '또봄 확인란'을 쓸 수 없다.
//   · 병원은 자기 제휴처의 건만 읽고 쓸 수 있다.
//   · 마감(locked)된 건은 아무도 수정할 수 없다.
//   · 감사 로그(auditLogs)는 생성만 되고 수정·삭제가 불가능하다.
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 ----------
    function myEmail() { return request.auth.token.email.lower(); }
    function rolePath() { return /databases/$(database)/documents/roles/$(myEmail()); }
    function roleDoc() { return get(rolePath()); }
    function hasRole() {
      return request.auth != null && exists(rolePath()) && roleDoc().data.active != false;
    }
    function myRole() { return roleDoc().data.role; }

    // 또봄 운영진 (owner / editor / viewer)
    function isStaff()  { return hasRole() && myRole() != 'hospital'; }
    function isEditor() { return isStaff() && (myRole() == 'owner' || myRole() == 'editor'); }
    function isOwner()  { return isStaff() && myRole() == 'owner'; }

    // 제휴 병원 담당자
    function isHospital() { return hasRole() && myRole() == 'hospital'; }
    function myPartner()  { return roleDoc().data.partnerId; }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- 게시글 ----------
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow create, update, delete: if isEditor();
    }

    // ---------- 권한 ----------
    match /roles/{email} {
      // 본인 문서는 본인이 읽을 수 있어야 로그인 시 역할 판별이 된다
      allow read: if isStaff() || (request.auth != null && email == myEmail());
      allow write: if isOwner();
    }

    // ---------- 제휴처 (요율 등 계약 조건 포함 — 비공개) ----------
    match /partners/{code} {
      allow read: if isStaff() || (isHospital() && code == myPartner());
      allow write: if isOwner();
    }

    // ---------- 제휴처 공개 정보 (소개 폼에서 코드 검증용) ----------
    match /partnerPublic/{code} {
      allow read: if true;                 // 이름 · 운영 여부만 담는다. 요율은 절대 넣지 말 것
      allow write: if isOwner();
    }

    // ---------- 소개 건 대장 ----------
    match /referrals/{id} {

      function newDoc() { return request.resource.data; }

      // 공개 신청 폼에서 들어오는 건: 모양을 엄격히 제한한다
      function validPublicCreate() {
        return newDoc().keys().hasOnly([
          'partnerId','source','createdAt','nameMasked','phone','phoneTail','personKey',
          'preferTime','memo','consent','consentAt','status','visitDate','revenue',
          'ttobomConfirmed','hospitalConfirmed','locked','month','createdBy'
        ])
        && newDoc().partnerId is string
        && exists(/databases/$(database)/documents/partnerPublic/$(newDoc().partnerId))
        && get(/databases/$(database)/documents/partnerPublic/$(newDoc().partnerId)).data.active == true
        && newDoc().status == 'requested'
        && newDoc().consent == true
        && newDoc().revenue == 0
        && newDoc().locked == false
        && newDoc().ttobomConfirmed == false
        && newDoc().hospitalConfirmed == false
        && newDoc().nameMasked is string && newDoc().nameMasked.size() <= 40
        && newDoc().phone is string && newDoc().phone.size() <= 20
        && (!('memo' in newDoc()) || newDoc().memo.size() <= 200);
      }

      allow create: if validPublicCreate();

      allow read: if isStaff() || (isHospital() && resource.data.partnerId == myPartner());

      // 병원: 내원 여부 · 방문일 · 매출액 · '병원 확인'만 쓸 수 있다
      function hospitalUpdate() {
        return isHospital()
          && resource.data.partnerId == myPartner()
          && changed().hasOnly(['status','visitDate','revenue','month',
                                'hospitalConfirmed','hospitalBy','hospitalAt','updatedAt'])
          && (!changed().hasAny(['hospitalBy']) || request.resource.data.hospitalBy == myEmail())
          // 한 번 확인한 건은 병원이 임의로 되돌릴 수 없다
          && (resource.data.hospitalConfirmed != true || request.resource.data.hospitalConfirmed == true)
          && request.resource.data.revenue >= 0;
      }

      // 또봄: '또봄 확인' · 연락 메모 · 마감 잠금만 쓸 수 있다
      function staffUpdate() {
        return isEditor()
          && changed().hasOnly(['ttobomConfirmed','ttobomBy','ttobomAt','memo','status','month',
                                'locked','phone','nameMasked','preferTime','updatedAt'])
          && (!changed().hasAny(['ttobomBy']) || request.resource.data.ttobomBy == myEmail())
          && (resource.data.ttobomConfirmed != true || request.resource.data.ttobomConfirmed == true)
          // 잠금 해제는 최고관리자만
          && (!changed().hasAny(['locked']) || request.resource.data.locked == true || isOwner());
      }

      allow update: if resource.data.locked != true && (hospitalUpdate() || staffUpdate());
      // 마감된 건의 잠금 해제는 최고관리자만, 그것도 잠금 필드 하나만
      allow update: if resource.data.locked == true && isOwner()
                    && changed().hasOnly(['locked','updatedAt'])
                    && request.resource.data.locked == false;

      allow delete: if isOwner() && resource.data.locked != true;
    }

    // ---------- 월 정산 (문서 ID = "제휴처코드_YYYYMM") ----------
    match /settlements/{sid} {

      function mine() { return isHospital() && sid.matches(myPartner() + '_.*'); }
      function baseKeys() {
        return ['partnerId','month','mode','rate','count','revenueSum','amount','status','updatedAt'];
      }

      allow read: if isStaff() || mine();

      // 최초 집계자가 기준 수치를 확정한다
      allow create: if (isEditor() || mine())
        && request.resource.data.keys().hasOnly(
             baseKeys().concat(['ttobomSignedBy','ttobomSignedAt','hospitalSignedBy','hospitalSignedAt']))
        && (isEditor()
              ? !('hospitalSignedAt' in request.resource.data)
              : !('ttobomSignedAt' in request.resource.data));

      // 이후에는 각자 '자기 서명'만 추가할 수 있다. 기준 수치는 못 바꾼다.
      allow update: if isEditor()
        && changed().hasOnly(['ttobomSignedBy','ttobomSignedAt','paidBy','paidAt','status','updatedAt'])
        && (!changed().hasAny(['ttobomSignedBy']) || request.resource.data.ttobomSignedBy == myEmail())
        && !('ttobomSignedAt' in resource.data);

      allow update: if isEditor()
        && changed().hasOnly(['paidBy','paidAt','status','updatedAt'])
        && request.resource.data.paidBy == myEmail();

      allow update: if mine()
        && changed().hasOnly(['hospitalSignedBy','hospitalSignedAt','updatedAt'])
        && request.resource.data.hospitalSignedBy == myEmail()
        && !('hospitalSignedAt' in resource.data);

      allow delete: if false;               // 정산 기록은 지우지 않는다
    }

    // ---------- 감사 로그 (append-only) ----------
    match /auditLogs/{id} {
      allow create: if hasRole() && request.resource.data.by == myEmail();
      allow read:   if isStaff() || (isHospital() && resource.data.partnerId == myPartner());
      allow update, delete: if false;
    }
  }
}
